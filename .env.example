# Cauldron OS — Environment Configuration
# Copy to .env and adjust as needed

# Server
PORT=3000
CAULDRON_HOST=127.0.0.1

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Cloud model timeouts (ms)
CAULDRON_CLOUD_TIMEOUT_MS=300000

# Generation settings
CAULDRON_CLARIFY_NUM_PREDICT=2048
CAULDRON_BLUEPRINT_NUM_PREDICT=8192

# Data directory (default: ./data)
# CAULDRON_DATA_DIR=./data
